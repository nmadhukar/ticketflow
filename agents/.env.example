# Local development of the assistant sidecar (`npm run dev` here, or the dev Docker stage).
# In Docker Compose these come from the `agents` service's environment instead.

ASSISTANT_ENABLED=true

# Must equal the app's ASSISTANT_AGENT_SECRET. Never set ASSISTANT_SESSION_SECRET here: the
# service refuses to start with it (it would let this service act as any user).
ASSISTANT_AGENT_SECRET=
# ASSISTANT_AGENT_SECRET_PREVIOUS=

# The app's internal listener (ASSISTANT_INTERNAL_PORT, default 5100).
ASSISTANT_MCP_URL=http://127.0.0.1:5100/internal/mcp

# Model: provider (openrouter or openai) and that provider's model id.
ASSISTANT_MODEL_PROVIDER=openrouter
ASSISTANT_MODEL=openai/gpt-5-mini
# Optional per-agent overrides:
# ASSISTANT_SUPPORT_MODEL=
# ASSISTANT_STAFF_MODEL=
OPENROUTER_API_KEY=

# Local Studio only (refused in production): at least 32 characters.
# MASTRA_STUDIO_TOKEN=
