# TicketFlow Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
PGHOST=localhost
PGPORT=5432
PGUSER=ticketflow_user
PGPASSWORD=your_secure_password
PGDATABASE=ticketflow

# Session Secret (Generate a random string for security)
# You can generate one using: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# First-run admin: created only when no admin who can log in exists.
# Leave unset after the first admin is created.
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=choose-a-long-random-password

# Demo accounts/tickets/articles with publicly known passwords. Development only;
# never set this to true in production.
# SEED_DEMO_DATA=true

# Application Environment
NODE_ENV=development
PORT=5000

# Public origin of the site. REQUIRED when NODE_ENV=production (the server refuses to
# start without it): emailed reset/invitation links, Teams card links and the SSO
# redirect are built from it, never from the request's Host header. In development,
# unset means "the origin the request came in on".
# APP_BASE_URL=https://tickets.yourcompany.com

# Optional (R36): team id that receives emailed tickets and customer tickets with no user or
# team assignee. Unset: they stay visible to admins only until triaged.
# DEFAULT_TRIAGE_TEAM_ID=1

# Optional (R52): the largest inbound email header block accepted, in bytes. A positive integer
# up to 262144; default 65536. A longer block is refused (logged, never ticketed). Junk, 0 or a
# value over the maximum logs one line and uses the default.
# INBOUND_EMAIL_MAX_HEADER_BYTES=65536

# Optional: database connection pool size (default 10). A wait for a connection fails after 10 s.
# PG_POOL_MAX=10

# Optional: resident memory (RSS) limit in MB for each document text extractor process (.docx/.pdf
# uploads; default 384, allowed 96-4096; at most two run at once).
# DOCUMENT_EXTRACT_MAX_MB=384

# ============================================
# OPTIONAL - AI AND AWS SERVICES
# ============================================

# OpenRouter powers ticket analysis, responses, chat, and knowledge features.
# Set this only in your local deployment environment or secret manager; never commit a real key.
OPENROUTER_API_KEY=

# Hindsight agent memory (optional). When enabled, the create-time agent recalls similar past
# resolutions before writing a reply and stores one memory when a ticket is resolved. OFF unless
# HINDSIGHT_ENABLED is exactly "true"; with it off no request is made.
# HINDSIGHT_ENABLED=true
# HINDSIGHT_URL=http://localhost:8888
# HINDSIGHT_BANK_ID=ticketflow
# HINDSIGHT_API_KEY=

# Mastra agent service (optional). A second way to drive the same ticket tools: it connects to
# TicketFlow's MCP endpoint (POST /api/mcp) with an mcp:tickets key and needs no change to the app.
# OFF unless MASTRA_AGENT_ENABLED is exactly "true". Start it with: npm run mastra:dev
# TICKETFLOW_MCP_KEY is the tfk_... value from Admin > Integrations > Developer resources.
# MASTRA_AGENT_ENABLED=true
# Which tools the agent may see. Every tool's schema is part of the prompt, and the full set is
# ~11k tokens: fine for a hosted model, too slow for a CPU-only local one (measured ~3.5 tok/s
# prompt processing on an i7-10610U). Unset = the triage subset below; "*" = every tool.
# MASTRA_TOOL_ALLOWLIST=get_ticket,list_tickets,search_knowledge,get_knowledge_article,search_documents,get_document,list_teams,list_departments,add_comment,whoami
# MASTRA_TOOL_ALLOWLIST=*
# MASTRA_AGENT_PORT=4111
# TICKETFLOW_MCP_URL=http://localhost:5000/api/mcp
# TICKETFLOW_MCP_KEY=
# Which Llama, and where it runs. Two shapes (a machine with no GPU should use Hosted):
#
#   Hosted (default, nothing to install): needs OPENROUTER_API_KEY.
# MASTRA_MODEL_ID=meta-llama/llama-3.3-70b-instruct
#
#   The customer-facing copilot (ticket creation from a conversation) needs a model that
#   follows multi-step tool instructions reliably. Llama 3.3 70B works for reading and
#   summarising, but it tends to keep asking clarifying questions instead of calling
#   create_ticket; on this path prefer a stronger tool-calling model, e.g.
# MASTRA_MODEL_ID=deepseek/deepseek-v4-pro
#   (Any OpenRouter "provider/model" id works; nothing else in the code changes.)
#
#   Local (nothing leaves this laptop): run LM Studio with its server on port 1234, load an
#   instruct model there, then use the "lmstudio/<model>" form. An 8B model at Q4 is the
#   practical ceiling on a 16GB laptop with no NVIDIA GPU; a 70B model will not fit.
# MASTRA_MODEL_ID=lmstudio/llama-3.1-8b-instruct
#   LM Studio needs no real key, but Mastra requires the variable to exist, so any non-empty
#   value works; without it every call fails with "Could not find API key process.env.LMSTUDIO_API_KEY".
# LMSTUDIO_API_KEY=lm-studio
#
# Other hosted Llama ids: meta-llama/llama-3.1-70b-instruct, meta-llama/llama-3.1-8b-instruct,
# meta-llama/llama-4-maverick, meta-llama/llama-4-scout.

# CopilotKit copilot (optional, needs the Mastra agent layer above). A floating chat popup in the
# browser whose agent is the same TicketFlow triage agent, over the AG-UI protocol: the copilot can
# read a ticket, search the knowledge base and name the owning team. It is a second, user-facing
# driver beside the help chatbot, DSH and the Mastra service. OFF unless COPILOTKIT_ENABLED is
# exactly "true"; it also requires MASTRA_AGENT_ENABLED=true (it borrows that model and MCP key).
# COPILOTKIT_ENABLED=true
# COPILOTKIT_BASE_PATH=/api/copilotkit
# COPILOTKIT_RESOURCE_ID=ticketflow-copilot

# AWS SES (email) and S3 (attachments) remain separate from the AI provider.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
# The S3 region is, in order: AWS_S3_REGION, then a region explicitly saved in Admin > AWS storage settings
# (anything other than us-east-1), then us-east-2. It does not default to AWS_REGION.
# AWS_S3_REGION=us-east-2

# Legacy Bedrock settings in the database are retained for rollback and S3 storage.
# They are not used for model calls in the OpenRouter build.

# ============================================
# OPTIONAL - MICROSOFT SSO
# ============================================

# Microsoft OAuth/Azure AD (Single Sign-On)
# Required only if you want Microsoft 365 login
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id

# Role of a NEW Microsoft SSO account: "customer" (default) or "agent". The account
# always waits for admin approval. Any other value is logged once and read as
# "customer". The role is set only when the account is created, never on a later sign-in.
# SSO_DEFAULT_ROLE=customer

# ============================================
# OPTIONAL - EMAIL (Alternative to AWS SES)
# ============================================

# SendGrid API (Alternative email provider)
SENDGRID_API_KEY=SG.xxx

# ============================================
# OPTIONAL - SECURITY & PERFORMANCE
# ============================================

# JWT Configuration (for API tokens)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Reverse proxies in front of the app (Express "trust proxy", R49): the NUMBER actually in front,
# an integer from 0 to 10 (above 10 or junk logs one line and uses 1). Default 1 (nginx alone).
# 2 only with Traefik AND nginx; 1 with nginx or Traefik alone; 0 with nothing in front. Too high
# lets a client choose its own address through X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Microsoft Teams webhooks (R84). OFF unless this is exactly "true".
# TEAMS_WEBHOOKS_ENABLED=true

# Rate Limiting
RATE_LIMITING_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5000,https://yourdomain.com
CORS_CREDENTIALS=true

# Input Validation
INPUT_VALIDATION_ENABLED=true
VALIDATION_STRICT_MODE=true

# ============================================
# REPLIT SPECIFIC (Auto-configured on Replit)
# ============================================

# Replit deployment information (set automatically)
REPL_ID=your-repl-id
REPLIT_DOMAINS=your-repl-slug.replit.app

# ============================================
# NOTES
# ============================================

# Default Admin Account (Auto-created on first startup):
# Email: admin@ticketflow.local
# Password: Admin123!
# 
# IMPORTANT: Change this password after first login!

# To generate secure secrets:
# - SESSION_SECRET: openssl rand -base64 32
# - JWT_SECRET: openssl rand -base64 32

# AWS Setup:
# 1. Create IAM user with Bedrock and SES permissions
# 2. Generate access keys
# 3. Never commit these to version control!

# Microsoft SSO Setup:
# 1. Register app in Azure Portal
# 2. Add redirect URI: https://your-domain.com/api/auth/microsoft/callback
# 3. Enable ID tokens and Access tokens
# 4. Add Microsoft Graph API permissions
