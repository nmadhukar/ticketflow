# TicketFlow Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED - Database Configuration
# =============================================================================
# Render.com automatically provides DATABASE_URL for PostgreSQL
# For local development, use your local PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/ticketflow

# =============================================================================
# REQUIRED - Security & Authentication
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-character-random-session-secret-here
JWT_SECRET=your-32-character-random-jwt-secret-here

# JWT Token Expiration (optional - defaults shown)
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=5000

# REQUIRED in production: the public origin of the site (no trailing path needed).
# Emailed reset/invitation links, Teams card links and the SSO redirect use it;
# the server refuses to start without it.
APP_BASE_URL=https://tickets.yourcompany.com

# Nginx Server Name (optional - defaults to _ which accepts any hostname)
# Set to your domain or IP address, or use _ to accept any hostname
SERVER_NAME=_

# =============================================================================
# AWS SERVICES (Optional - for email and AI features)
# =============================================================================
# Get these from AWS IAM console
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# S3 Configuration (for file storage - attachments and logos)
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION=us-east-1  # Optional, defaults to AWS_REGION

# File Upload Limits (Optional - defaults shown)
MAX_FILE_UPLOAD_SIZE_MB=50  # Maximum file size per file in MB (default: 50MB)
MAX_FILES_PER_REQUEST=10     # Maximum number of files per request (default: 10)
MAX_REQUEST_SIZE_MB=50      # Maximum request body size in MB (default: 50MB)

# =============================================================================
# MICROSOFT SSO (Optional - for Azure AD integration)
# =============================================================================
# Get these from Azure App Registration
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id
MICROSOFT_REDIRECT_URL=http://localhost:5000/api/auth/microsoft/callback

# =============================================================================
# SECURITY & RATE LIMITING (Optional - defaults shown)
# =============================================================================
# Enable/disable security features
CORS_ENABLED=true
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Rate limiting settings
RATE_LIMITING_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Reverse proxies in front of the app (Express "trust proxy", R49): an integer of 0 or more,
# default 1 (nginx alone). Set 2 behind Coolify/Traefik plus nginx. 0 trusts no proxy header.
TRUST_PROXY_HOPS=1

# Microsoft Teams incoming webhooks (R84). OFF unless this is exactly "true": off, ticket events send
# nothing, the admin test button answers 503 and saving webhook settings answers 409
# (teams_webhooks_disabled). Set to true and restart to let an admin configure a webhook.
# TEAMS_WEBHOOKS_ENABLED=true

# Input validation
INPUT_VALIDATION_ENABLED=true
VALIDATION_STRICT_MODE=true

# =============================================================================
# DEVELOPMENT ONLY (Don't use in production)
# =============================================================================
# Uncomment for local development
# NODE_ENV=development
# DEBUG=true
# LOG_LEVEL=debug

# PostgreSQL Port (development only)
# Set to 5432 to expose PostgreSQL port for Adminer/local database tools
# For production: Omit this variable or leave empty
# Note: Even if port is mapped, use security groups/firewall to restrict access
POSTGRES_PORT=5432

# =============================================================================
# RENDER.COM DEPLOYMENT NOTES
# =============================================================================
# 1. DATABASE_URL is automatically provided by Render PostgreSQL
# 2. PORT is automatically set by Render
# 3. SESSION_SECRET and JWT_SECRET can be auto-generated in render.yaml
# 4. Add AWS credentials in Render dashboard if you have them
# 5. Add Microsoft SSO credentials in Render dashboard if configured
# 6. All other settings use sensible defaults
